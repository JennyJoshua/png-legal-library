{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PNG Legal Library Document Version History",
  "description": "Append-only provenance records for observed document files. Version records do not establish legal status or permission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "history_version",
    "jurisdiction",
    "versions"
  ],
  "properties": {
    "history_version": {
      "type": "string",
      "const": "1.0"
    },
    "jurisdiction": {
      "type": "string",
      "const": "Papua New Guinea"
    },
    "versions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/version"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_id",
        "document_id",
        "version_number",
        "checksum_sha256",
        "file_name",
        "file_size_bytes",
        "media_type",
        "source_url",
        "source_id",
        "observed_at",
        "previous_version_id",
        "review_status",
        "redistribution_permission",
        "archived_path"
      ],
      "properties": {
        "version_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{16}$"
        },
        "document_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "version_number": {
          "type": "integer",
          "minimum": 1
        },
        "checksum_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "file_name": {
          "type": "string",
          "minLength": 1
        },
        "file_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "previous_version_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{16}$"
        },
        "review_status": {
          "type": "string",
          "const": "pending_review"
        },
        "redistribution_permission": {
          "type": "string",
          "enum": [
            "permitted",
            "restricted",
            "prohibited",
            "unknown"
          ]
        },
        "archived_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "pending_review",
            "verified",
            "verification_failed"
          ]
        },
        "verification_evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
