{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PNG Legal Library Source Registry",
  "description": "Defines source endpoints approved for discovery consideration. Inclusion is not proof of authenticity, current legal status, or redistribution rights.",
  "type": "object",
  "required": [
    "registry_version",
    "purpose",
    "discovery_rules",
    "sources",
    "future_source_policy"
  ],
  "properties": {
    "registry_version": {
      "type": "integer",
      "minimum": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "discovery_rules": {
      "type": "object",
      "required": [
        "automatic_discovery",
        "automatic_legal_status_changes",
        "automatic_redistribution_approval",
        "require_human_review_before_verification",
        "retain_source_url",
        "record_discovery_date",
        "store_personal_case_information"
      ],
      "properties": {
        "automatic_discovery": {
          "type": "boolean"
        },
        "automatic_legal_status_changes": {
          "const": false
        },
        "automatic_redistribution_approval": {
          "const": false
        },
        "require_human_review_before_verification": {
          "const": true
        },
        "retain_source_url": {
          "const": true
        },
        "record_discovery_date": {
          "const": true
        },
        "store_personal_case_information": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "future_source_policy": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "name",
        "url",
        "source_type",
        "discovery_scope",
        "review_status",
        "redistribution_permission"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "official_government",
            "official_judicial",
            "legal_information_service",
            "independent_constitutional_institution"
          ]
        },
        "discovery_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review_status": {
          "type": "string",
          "enum": [
            "candidate",
            "needs_verification",
            "verified",
            "rejected"
          ]
        },
        "redistribution_permission": {
          "type": "string",
          "enum": [
            "permitted",
            "restricted",
            "prohibited",
            "unknown"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
