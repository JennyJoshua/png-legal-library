{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"PNG Legal Library Local Search Index",
  "type":"object",
  "required":["index_schema_version","built_at","record_count","records","warning"],
  "properties":{
    "index_schema_version":{"const":"1.0"},
    "built_at":{"type":"string","format":"date-time"},
    "record_count":{"type":"integer","minimum":0},
    "warning":{"type":"string","minLength":1},
    "records":{"type":"array","items":{"type":"object","required":["node_id","document_id","version_id","kind","text","source_reference","source_checksum_sha256","structure_path"],"properties":{
      "node_id":{"type":"string"},"document_id":{"type":"string"},"version_id":{"type":"string","pattern":"^[a-f0-9]{16}$"},
      "kind":{"enum":["part","division","subpart","section","subsection","paragraph","subparagraph","unstructured"]},
      "number":{"type":["string","null"]},"title":{"type":"string"},"text":{"type":"string"},"source_reference":{"type":"string"},
      "page_number":{"type":["integer","null"],"minimum":1},"paragraph_number":{"type":["integer","null"],"minimum":1},
      "source_checksum_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"structure_path":{"type":"array"},
      "document_title":{"type":"string"},"source_url":{"type":["string","null"]},"source_id":{"type":["string","null"]},"format":{"type":["string","null"]}
    },"additionalProperties":true}}
  }
}
